{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome (dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "/src/*": "${workspaceFolder}/src/*"
      },
      "preLaunchTask": "dev",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Attach to Chrome",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "/src/*": "${workspaceFolder}/src/*"
      }
    }
  ]
}
